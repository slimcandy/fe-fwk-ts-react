{
  "name": "fe-fwk-ts-react",
  "version": "1.0.0",
  "private": true,
  "description": "A TypeScript port of the framework from the book Build a Frontend Web Framework (From Scratch), with React's names, tested against react-dom.",
  "keywords": [
    "virtual-dom",
    "reconciliation",
    "frontend-framework",
    "react",
    "typescript",
    "educational"
  ],
  "homepage": "https://react.avolkov.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimcandy/fe-fwk-ts-react.git"
  },
  "bugs": {
    "url": "https://github.com/slimcandy/fe-fwk-ts-react/issues"
  },
  "author": "Aleksei Volkov",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/runtime",
    "examples/notes"
  ],
  "scripts": {
    "test": "npm test -w packages/runtime",
    "build": "npm run build -w packages/runtime",
    "dev": "npm run dev -w examples/notes",
    "build:site": "npm run build -w examples/notes",
    "start": "npm run preview -w examples/notes"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
